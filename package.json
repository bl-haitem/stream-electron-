{
  "name": "my-react-electron-app",
  "version": "0.0.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.20",
    "electron": "^26.2.0",
    "electron-builder": "^26.0.12",
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.hw.desktop",
    "productName": "HAITOMASworld",
    "files": [
      "dist/**/*",
      "main.js",
      "package.json",
      "public/electron-preload.js"
    ],
    "directories": { "buildResources": "assets" },
    "win": { "target": "nsis", "icon": "src/assets/icon.ico" },
    "mac": { "target": "dmg", "icon": "assets/icon.icns" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" }
  }
}
